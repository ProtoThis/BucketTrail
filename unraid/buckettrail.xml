<?xml version="1.0"?>
<Container version="2">
  <Name>BucketTrail</Name>
  <Repository>ghcr.io/protothis/buckettrail:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP />
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ProtoThis/BucketTrail</Support>
  <Project>https://github.com/ProtoThis/BucketTrail</Project>
  <Overview><![CDATA[BucketTrail is a self-hosted travel bucket list and trip planner with a map-based UI, SQLite persistence, and a single-container deployment.]]></Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/ProtoThis/BucketTrail/main/unraid/buckettrail.xml</TemplateURL>
  <Icon />
  <ExtraParams />
  <PostArgs />
  <CPUset />
  <DateInstalled />
  <DonateText />
  <DonateLink />
  <Requires>Persistent storage for /data</Requires>
  <Config Name="Web UI Port" Target="8000" Default="8000" Mode="tcp" Description="Port for the BucketTrail web interface" Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="AppData" Target="/data" Default="/mnt/user/appdata/buckettrail" Mode="rw" Description="Persistent BucketTrail database storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/buckettrail</Config>
</Container>
